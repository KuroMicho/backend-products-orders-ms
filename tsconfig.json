{
	"compilerOptions": {
		"module": "CommonJS",
		"baseUrl": "./src",
		"paths": {
		  "@/*": ["./*"]
		},
		"moduleResolution": "Node",
		"target": "ES2020",
		"outDir": "./dist",
		"rootDir": "./src",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*"]
}
